`--buildinfo` says "static image" only when built with STATIC=1, which also
defines BUILD_STATIC and with it turns off the stressors that need a shared
libc (dynlib, plugin, uprobe…) and several shims. This build is static through
the toolchain instead, so it reported "dynamic link". Print the truth without
touching BUILD_STATIC's other effects. Applied to the static-musl Linux builds
only: on macOS the binary does link libSystem dynamically.

--- a/core-helper.c
+++ b/core-helper.c
@@ -692,11 +692,7 @@
 #if defined(__STDC_HOSTED__)
 		pr_inf("STDC Hosted: " XSTR(__STDC_HOSTED__) "\n");
 #endif
-#if defined(BUILD_STATIC)
 		pr_inf("build: static image\n");
-#else
-		pr_inf("build: dynamic link\n");
-#endif
 	}
 }
 
